# Docker Compose project name: prefixes every container, network, and volume
# (dbarena_*). Keep it stable so the documented commands and volume names match.
COMPOSE_PROJECT_NAME=dbarena

# Control-plane PostgreSQL (admindb): task catalog, sessions, episode history,
# and GUI/agent configuration. Published on 127.0.0.1:ADMINDB_PORT by the
# access overlay. Change the password for anything beyond a local demo.
ADMINDB_USER=dbarena
ADMINDB_PASSWORD=change-me-admin
ADMINDB_DB=dbarena

# OLTP playground PostgreSQL (taskdb): the TPC-C fixture the OLTP tasks run
# against. Published on 127.0.0.1:TASKDB_PORT by the access overlay.
TASKDB_USER=dbarena
TASKDB_PASSWORD=change-me-task
TASKDB_DB=taskdb

# Analytics fixture (DuckDB, TPC-H): in-container path of the seeded file.
# No host port is published; the backend opens the file read-write.
# Four slashes are required: the last pair starts the absolute file path.
OLAPDB_URL=duckdb:////data/olap-tpch.duckdb

# OLAP fixture (DuckDB, TPC-DS): in-container path of the seeded file.
# Same rules as OLAPDB_URL; the backend mounts it at /ds.
DSDB_URL=duckdb:////ds/tpcds.duckdb

# RAG fixture (PostgreSQL 17 + pgvector): corpus and embeddings database.
RAGDB_USER=dbarena
RAGDB_PASSWORD=change-me-vectors
RAGDB_DB=ragdb
# Declared host port for ragdb. Verified inert today: the container sits only
# on the internal network, so host connections to this port fail; reach ragdb
# through the backend/GUI.
RAGDB_PORT=5435

# Embedding endpoint (OpenAI-compatible /v1/embeddings) used by the embedding
# lifecycle. Default targets the in-stack SGLang server (make embed-server,
# BAAI/bge-large-en-v1.5, dim 1024 — GPU detected automatically when present).
# Point it at any other OpenAI-compatible server (SGLang/Ollama/LM Studio/OpenAI)
# here or from the admin GUI modal. EMBEDDING_API_KEY is optional.
EMBEDDING_BASE_URL=http://embed-server:30000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# Answer judge (judged RAG tasks): an OpenAI-compatible chat endpoint the judge
# service calls for pass/fail verdicts. Set YOUR endpoint here — scheme://host:port
# plus whatever API prefix your server uses (commonly, but not always, /v1) — or
# configure it later from the admin GUI (stored values take precedence over these
# bootstrap values). Left empty, judged tasks fail with a connection error until
# the endpoint is configured.
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=

# LangSmith tracing for the judge's LLM calls (set LANGSMITH_API_KEY to enable;
# traces land in the project below).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dbarena-answer-judge
LANGSMITH_TRACING=true

# Host ports published by the access overlay (docker-compose.access.yml), all
# bound to 127.0.0.1 only — the base compose file publishes no ports.
# FRONTEND_PORT → admin GUI at http://127.0.0.1:8080
# BACKEND_PORT  → admin API at http://127.0.0.1:8000
# MCP_PORT      → MCP streamable-HTTP at http://127.0.0.1:8090/mcp
# ADMINDB_PORT / TASKDB_PORT → psql access to the two PostgreSQL stores
FRONTEND_PORT=8080
BACKEND_PORT=8000
MCP_PORT=8090
ADMINDB_PORT=5433
TASKDB_PORT=5434

# Idle timeout (seconds) for MCP HTTP sessions; 0 disables expiry. Consumed by
# the mcp service (compose default 0). stdio clients use DBARENA_TIMEOUT_SECONDS
# instead (default 120, see the MCP section of the README).
MCP_SESSION_IDLE_TIMEOUT=0
